# Configuración de Variables de Entorno

# Copiar este archivo como .env y configurar con tus valores reales

# API Key de Groq (gratis) - Obtén tu key en https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui

# O usar OpenAI (de pago)
# OPENAI_API_KEY=tu_openai_api_key_aqui

# Modelo a usar
# Para Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama-3.1-8b-instant
# Para OpenAI: gpt-3.5-turbo, gpt-4
MODEL_NAME=llama-3.3-70b-versatile
